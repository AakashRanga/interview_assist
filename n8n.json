
{
  "name": "Interview Scheduler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "schedule-interview",
        "responseMode": "responseNode"
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "schedule-interview"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { candidate_name: $json.body.candidate_name, email: $json.body.email, job_role: $json.body.job_role, start_datetime: $json.body.date + 'T' + $json.body.start_time, end_datetime: $json.body.date + 'T' + $json.body.end_time } }];"
      },
      "id": "2",
      "name": "Prepare Interview Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "akashranga27@gmail.com"
        },
        "start": "={{$json.start_datetime}}",
        "end": "={{$json.end_datetime}}",
        "additionalFields": {
          "summary": "Interview Scheduled - {{$json.candidate_name}}",
          "description": "Job Role: {{$json.job_role}}",
          "attendees": [
            "={{$json.email}}"
          ],
          "conferenceDataUi": {
            "conferenceDataValues": {
              "conferenceSolution": "Google Meet"
            }
          }
        }
      },
      "id": "3",
      "name": "Technical Interview",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [850, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "lRpnmazMu017bDZA",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "4",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Interview Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Interview Data": {
      "main": [
        [
          {
            "node": "Technical Interview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Technical Interview": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

